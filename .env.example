# LLM
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_FALLBACK_MODEL=gemini-1.5-pro
JUDGE_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0
LLM_RPM_LIMIT=10

# Data stores
POSTGRES_ADMIN_URL=postgresql://ontoagent_admin:admin_secret@localhost:5432/ontoagent
POSTGRES_RO_URL=postgresql://ontoagent_ro:ro_secret@localhost:5432/ontoagent
POSTGRES_KB_URL=postgresql://ontoagent_kb:kb_secret@localhost:5432/ontoagent
POSTGRES_APP_URL=postgresql://ontoagent_app:app_secret@localhost:5432/ontoagent
POSTGRES_OPS_URL=postgresql://ontoagent_ops:ops_secret@localhost:5432/ontoagent
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontoagent_neo4j_password

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Domain
AS_OF_DATE=2018-09-01
DATASET=sample

# Safety
APPROVAL_HMAC_SECRET=c8e7b1a2d3f4e5a6b7c8d9e0f1a2b3c4
PSEUDONYM_SECRET=f1e2d3c4b5a60718293a4b5c6d7e8f90
